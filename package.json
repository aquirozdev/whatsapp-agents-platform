{
  "name": "whatsapp-agents-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-portable multi-tenant runtime for enterprise conversational agents.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "seed:tenant": "tsx src/scripts/seed-tenant.ts",
    "validate:tenant": "tsx src/scripts/validate-tenant.ts",
    "admin": "tsx src/admin/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1136.0",
    "@aws-sdk/client-dynamodb": "^3.1136.0",
    "@aws-sdk/client-secrets-manager": "^3.1136.0",
    "@aws-sdk/client-sesv2": "^3.1136.0",
    "@aws-sdk/client-sns": "^3.1136.0",
    "@aws-sdk/client-sqs": "^3.1136.0",
    "@aws-sdk/lib-dynamodb": "^3.1136.0",
    "aws-cdk-lib": "^2.270.0",
    "ajv": "^8.17.1",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^22.18.6",
    "aws-cdk": "^2.1142.0",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
